  <note>
    <title>빅파일 메가메일 서버 화승 비밀번호 그룹웨어</title>
    <created>20190211T064824Z</created>
    <updated>20210208T030608Z</updated>
    <note-attributes>
      <author>bbb1sss2@gmail.com</author>
      <source>desktop.win</source>
      <source-application>evernote.win32</source-application>
    </note-attributes>
    <content>
      <![CDATA[<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!DOCTYPE en-note SYSTEM "http://xml.evernote.com/pub/enml2.dtd"><en-note><div>빅파일 - big!@#123</div><div><br /></div><div>메가메일 - mega!@#123</div><div><br /></div><div>그룹웨어- gw!@#123</div><div><br /></div><div>메일서버- mail!@#123</div></en-note>      ]]>
