    <content>
      <![CDATA[<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!DOCTYPE en-note SYSTEM "http://xml.evernote.com/pub/enml2.dtd"><en-note><br/><div style="font-size: 16px"><div style="font-family:&apos;Malgun Gothic&apos;, Gulim, &apos;Segoe UI&apos;, &apos;Lucida Grande&apos;, Verdana, Arial, Helvetica, sans-serif;"><div style="font-family:&apos;Malgun Gothic&apos;, Gulim, &apos;Segoe UI&apos;, &apos;Lucida Grande&apos;, Verdana, Arial, Helvetica, sans-serif;font-style:normal;font-variant:normal;font-weight:normal;font-stretch:normal;font-size:13px;line-height:1.35;color:rgb(0, 0, 0);">
        <div style="font-family:&apos;Malgun Gothic&apos;, Gulim, &apos;Segoe UI&apos;, &apos;Lucida Grande&apos;, Verdana, Arial, Helvetica, sans-serif;min-width:1120px;">
            

            
            
            
    

    
    
    
    
    <div dir="ltr" style="font-family:&apos;Malgun Gothic&apos;, Gulim, &apos;Segoe UI&apos;, &apos;Lucida Grande&apos;, Verdana, Arial, Helvetica, sans-serif;display:block;width:auto;margin:0px auto;position:relative;font-size:16px;line-height:1;background-color:rgb(0, 0, 0);">
        

        <div style="font-family:&apos;Malgun Gothic&apos;, Gulim, &apos;Segoe UI&apos;, &apos;Lucida Grande&apos;, Verdana, Arial, Helvetica, sans-serif;display:inline-block;width:98%;margin-top:13px;padding:0px 1%;">
            <div style="font-family:&apos;Malgun Gothic&apos;, Gulim, &apos;Segoe UI&apos;, &apos;Lucida Grande&apos;, Verdana, Arial, Helvetica, sans-serif;clear:both;margin:0px auto;">
                
                <div style="font-family:&apos;Malgun Gothic&apos;, Gulim, &apos;Segoe UI&apos;, &apos;Lucida Grande&apos;, Verdana, Arial, Helvetica, sans-serif;float:left;">
                    <div style="font-family:&apos;Malgun Gothic&apos;, Gulim, &apos;Segoe UI&apos;, &apos;Lucida Grande&apos;, Verdana, Arial, Helvetica, sans-serif;margin:0px 0px 0px -1px;">  
                        
                            <a href="http://msdn.microsoft.com/ko-kr" style="font-family:&apos;Malgun Gothic&apos;, Gulim, &apos;Segoe UI&apos;, &apos;Lucida Grande&apos;, Verdana, Arial, Helvetica, sans-serif;text-decoration:none;display:block;margin:0px 0px 4px 2px;">
                               <en-media type="image/png" hash="2e391eaad72b547e3ecb28df81d41448" width="85" height="18" style="font-family:&apos;Malgun Gothic&apos;, Gulim, &apos;Segoe UI&apos;, &apos;Lucida Grande&apos;, Verdana, Arial, Helvetica, sans-serif;border:none;"></en-media>
                            </a>
                                                             
                        <div style="font-family:&apos;Malgun Gothic&apos;, Gulim, &apos;Segoe UI&apos;, &apos;Lucida Grande&apos;, Verdana, Arial, Helvetica, sans-serif;">
  <div style="font-family:&apos;Malgun Gothic&apos;, Gulim, &apos;Segoe UI&apos;, &apos;Lucida Grande&apos;, Verdana, Arial, Helvetica, sans-serif;">
    <a href="http://msdn.microsoft.com/ko-kr" style="font-family:&apos;Malgun Gothic&apos;, Gulim, &apos;Segoe UI&apos;, &apos;Lucida Grande&apos;, Verdana, Arial, Helvetica, sans-serif;text-decoration:none;display:inline-block;font-size:1.5em;color:rgb(255, 255, 255);letter-spacing:0.5px;margin:0px 0px 0px 1px;">
      <en-media type="image/jpeg" hash="51982ebe2269c5526634eba737f60fe3" width="162" height="25" style="font-family:&apos;Malgun Gothic&apos;, Gulim, &apos;Segoe UI&apos;, &apos;Lucida Grande&apos;, Verdana, Arial, Helvetica, sans-serif;border:none;vertical-align:top;"></en-media>
      <span style="font-family:&apos;Malgun Gothic&apos;, Gulim, &apos;Segoe UI&apos;, &apos;Lucida Grande&apos;, Verdana, Arial, Helvetica, sans-serif;"></span>
    </a>
  </div>
</div>    

                    </div>
                    
                </div>
                
                <div style="font-family:&apos;Malgun Gothic&apos;, Gulim, &apos;Segoe UI&apos;, &apos;Lucida Grande&apos;, Verdana, Arial, Helvetica, sans-serif;float:right;color:rgb(156, 156, 156);font-size:0.8125em;">
                    <div style="font-family:&apos;Malgun Gothic&apos;, Gulim, &apos;Segoe UI&apos;, &apos;Lucida Grande&apos;, Verdana, Arial, Helvetica, sans-serif;max-width:700px;text-align:right;margin:0px 0px 8px;">
                        <div style="font-family:&apos;Malgun Gothic&apos;, Gulim, &apos;Segoe UI&apos;, &apos;Lucida Grande&apos;, Verdana, Arial, Helvetica, sans-serif;margin-left:27px;display:inline-block;">

<a href="https://login.live.com/login.srf?wa=wsignin1.0&amp;rpsnv=12&amp;ct=1418617588&amp;rver=6.0.5276.0&amp;wp=MCLBI&amp;wlcxt=MSDN%24MSDN%24MSDN&amp;wreply=http%3a%2f%2fmsdn.microsoft.com%2fko-kr%2flibrary%2fs2dy91zy.aspx&amp;lc=1042&amp;id=254354&amp;mkt=ko-KR" title="로그인" style="font-family:&apos;Malgun Gothic&apos;, Gulim, &apos;Segoe UI&apos;, &apos;Lucida Grande&apos;, Verdana, Arial, Helvetica, sans-serif;text-decoration:none;color:rgb(255, 255, 255);line-height:1.5em;font-size:0.875em;">로그인</a></div>

    

                        <div style="font-family:&apos;Malgun Gothic&apos;, Gulim, &apos;Segoe UI&apos;, &apos;Lucida Grande&apos;, Verdana, Arial, Helvetica, sans-serif;margin-left:27px;display:inline-block;">
  <a href="https://msdn.microsoft.com/subscriptions/manage/hh442900" style="font-family:&apos;Malgun Gothic&apos;, Gulim, &apos;Segoe UI&apos;, &apos;Lucida Grande&apos;, Verdana, Arial, Helvetica, sans-serif;text-decoration:none;color:rgb(255, 255, 255);line-height:1.5em;font-size:0.875em;">MSDN Subscription</a>
