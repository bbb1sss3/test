            <div style="font-family:&apos;Malgun Gothic&apos;, Gulim, &apos;Segoe UI&apos;, &apos;Lucida Grande&apos;, Verdana, Arial, Helvetica, sans-serif;padding:0px;margin:0px;color:Black;"><pre style="font-family:Consolas, Courier, monospace;padding:5px;margin:0px;font-style:normal;font-weight:normal;overflow:auto;word-wrap:normal;">
<span style="font-family:&apos;Malgun Gothic&apos;, Gulim, &apos;Segoe UI&apos;, &apos;Lucida Grande&apos;, Verdana, Arial, Helvetica, sans-serif;color:Blue;">Dim</span> aDec <span style="font-family:&apos;Malgun Gothic&apos;, Gulim, &apos;Segoe UI&apos;, &apos;Lucida Grande&apos;, Verdana, Arial, Helvetica, sans-serif;color:Blue;">As</span> <span style="font-family:&apos;Malgun Gothic&apos;, Gulim, &apos;Segoe UI&apos;, &apos;Lucida Grande&apos;, Verdana, Arial, Helvetica, sans-serif;color:Blue;">Decimal</span>
