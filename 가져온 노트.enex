  <note>
    <title>직인 이미지는</title>
    <created>20150226T080008Z</created>
    <updated>20150401T044334Z</updated>
    <note-attributes>
    </note-attributes>
    <content>
      <![CDATA[<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!DOCTYPE en-note SYSTEM "http://xml.evernote.com/pub/enml2.dtd">

<en-note style="word-wrap: break-word; -webkit-nbsp-mode: space; -webkit-line-break: after-white-space;">
직인 이미지는 서버 알어드민으로 접속해서&nbsp;<br/><a href="file:///E:/Lotus/Domino/data/domino/icons">E:\Lotus\Domino\data\domino\icons</a>&nbsp;넣어줘야됨
<div><br/></div><div>결재함에 들어 있는 이미지 이름과 서버에 들어갈 이미지 이름이 동일해야 함!<br/>
&nbsp;
<div><br/></div><div>알어드민 비밀번호: ag테크- 12345678</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; gmb-&gt;kgmb_1234</div></div></en-note>      ]]>
    </content>
  </note>
  <note>
    <title>첨부파일 빼기 에이젼트</title>
    <created>20141201T074707Z</created>
    <updated>20141201T074718Z</updated>
    <note-attributes>
    </note-attributes>
    <content>
      <![CDATA[<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!DOCTYPE en-note SYSTEM "http://xml.evernote.com/pub/enml2.dtd">

<en-note style="word-wrap: break-word; -webkit-nbsp-mode: space; -webkit-line-break: after-white-space;">
Sub Initialize<br/>
&nbsp;&nbsp;&nbsp;&nbsp; Dim s As New NotesSession<br/>
&nbsp;&nbsp;&nbsp;&nbsp; Dim w As New NotesUIWorkspace<br/>
&nbsp;&nbsp;&nbsp;&nbsp; Dim db As NotesDatabase&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &apos; current app<br/>
&nbsp;&nbsp;&nbsp;&nbsp; Dim uiV As NotesUIView&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &apos; current view front-end<br/>
&nbsp;&nbsp;&nbsp;&nbsp; Dim V As NotesView&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &apos; current view backend<br/>
&nbsp;&nbsp;&nbsp;&nbsp; Dim vECol As NotesViewEntryCollection&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &apos; all entires in v<br/>
&nbsp;&nbsp;&nbsp;&nbsp; Dim vE As NotesViewEntry&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &apos; view/doc entry in vECol<br/>
&nbsp;&nbsp;&nbsp;&nbsp; Dim vDoc As NotesDocument&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &apos; vE&apos;s back-end document<br/>
&nbsp;&nbsp;&nbsp;&nbsp; Dim vO As NotesEmbeddedObject&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &apos; embedded object in vDoc<br/>
&nbsp;&nbsp;&nbsp;&nbsp;<br/>
&nbsp;&nbsp;&nbsp;&nbsp; Dim promptme As Integer&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &apos; prompt to continue - yes/ok=6<br/>
&nbsp;&nbsp;&nbsp;&nbsp; Dim fdefaultpath As String&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &apos; default save path from environment<br/>
&nbsp;&nbsp;&nbsp;&nbsp; Dim fPrompt As Variant&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &apos; prompt variant for file path<br/>
&nbsp;&nbsp;&nbsp;&nbsp; Dim fdir As String&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &apos; folder to save path selected/typed in<br/>
&nbsp;&nbsp;&nbsp;&nbsp; Dim cfilecount As Integer&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &apos; count for files in a doc<br/>
&nbsp;&nbsp;&nbsp;&nbsp;<br/>
&nbsp;&nbsp;&nbsp;&nbsp; On Error Goto SErrorHandler<br/>
&nbsp;&nbsp;&nbsp;&nbsp;<br/>
&nbsp;&nbsp;&nbsp;&nbsp; &apos; set-up<br/>
&nbsp;&nbsp;&nbsp;&nbsp; Set db = s.CurrentDatabase<br/>
&nbsp;&nbsp;&nbsp;&nbsp; Set uiV = w.Currentview<br/>
&nbsp;&nbsp;&nbsp;&nbsp; If (uiV Is Nothing) Then<br/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &apos; give up<br/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Print &quot;Cancelled export. No current view open.&quot;<br/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Exit Sub<br/>
&nbsp;&nbsp;&nbsp;&nbsp; Else<br/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &apos; get backend view<br/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Set v = uiV.View<br/>
&nbsp;&nbsp;&nbsp;&nbsp; End If<br/>
&nbsp;&nbsp;&nbsp;&nbsp; Set vECol = v.Allentries<br/>
&nbsp;&nbsp;&nbsp;&nbsp; If (vECol.Count = 0) Then<br/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &apos; no entries/docs to process<br/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Print &quot;Cancelled export. No entries in view to export.&quot;<br/>
&nbsp;&nbsp;&nbsp;&nbsp; End If<br/>
&nbsp;&nbsp;&nbsp;&nbsp; promptme = Msgbox(&quot;You are about to extract all attachments from all documents in this view. &quot; &amp;_<br/>
&nbsp;&nbsp;&nbsp;&nbsp; &quot;You will be prompted where to save the documents. Would you like to continue.&quot;, 32 + 4, &quot;Export Attachments&quot;)<br/>
&nbsp;&nbsp;&nbsp;&nbsp; If Not (promptme = 6) Then<br/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Print &quot;Cancelled export as requested.&quot;<br/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Exit Sub<br/>
&nbsp;&nbsp;&nbsp;&nbsp; End If<br/>
&nbsp;&nbsp;&nbsp;&nbsp; &apos; update following line to preferred path<br/>
&nbsp;&nbsp;&nbsp;&nbsp; fdefaultpath = &quot;c:\temp\extract&quot;<br/>
&nbsp;&nbsp;&nbsp;&nbsp; &apos; get the folder to export<br/>
&nbsp;&nbsp;&nbsp;&nbsp; fPrompt = w.Savefiledialog(False, &quot;Export Location?&quot;, &quot;All files|*.*&quot;, fdefaultpath, &quot;Choose and Save&quot;)<br/>
&nbsp;&nbsp;&nbsp;&nbsp; If (Isempty(fPrompt) ) Then<br/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Print &quot;Cancelled. No folder selected.&quot;<br/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Exit Sub<br/>
&nbsp;&nbsp;&nbsp;&nbsp; End If<br/>
&nbsp;&nbsp;&nbsp;&nbsp; fdir = Strleftback(Cstr(fPrompt(0)), &quot;Choose and Save&quot;, 5, 1 )<br/>
&nbsp;&nbsp;&nbsp;&nbsp; If (fdir = &quot;&quot;) Then<br/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &apos; cancel<br/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Print &quot;Error parsing folder location.&quot;<br/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Exit Sub<br/>
&nbsp;&nbsp;&nbsp;&nbsp; End If<br/>
&nbsp;&nbsp;&nbsp;&nbsp; Print &quot;Export location: &quot; &amp; fdir &amp; &quot;. Starting export . . . &quot;<br/>
&nbsp;&nbsp;&nbsp;&nbsp;<br/>
&nbsp;&nbsp;&nbsp;&nbsp; &apos; loop through all entries and process attachments<br/>
&nbsp;&nbsp;&nbsp;&nbsp; Set vE = vECol.Getfirstentry()<br/>
&nbsp;&nbsp;&nbsp;&nbsp; While Not (vE Is Nothing)<br/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &apos; get doc<br/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; If (vE.Isdocument) Then<br/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Set vDoc = vE.Document<br/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; cfilecount = 0<br/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; If Not (vDoc Is Nothing) Then<br/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &apos; check if has embedded objects / attachments<br/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; If (vDoc.HasEmbedded) Then<br/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &apos; see if embedded objects are attachments<br/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &apos; do NOT use doc.EmbeddedObjects - it will blow up w/a type missmatch error<br/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Forall i In vDoc.Items<br/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; If (i.Type = 1084) Then<br/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &apos; attachment type, continue<br/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Forall ival In i.Values<br/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &apos; get attachment<br/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Set vO = vDoc.GetAttachment(ival)<br/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; If (vO.Type = 1454) Then<br/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &apos; EMBED_ATTACHMENT (1454)<br/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &apos; process attachment<br/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Call vO.ExtractFile( fdir &amp; vDoc.Universalid &amp; &quot;_&quot; &amp; Cstr(cfilecount) &amp; &quot;_&quot; &amp; vO.Name )<br/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &apos; increment counter<br/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; cfilecount = cfilecount + 1<br/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Else<br/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &apos; object is not attachment<br/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; End If<br/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; End Forall<br/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Else<br/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &apos; not attachment item<br/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; End If<br/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; End Forall<br/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; End If<br/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; End If<br/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; End If<br/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &apos; loop to next entry<br/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Set vE = vECol.Getnextentry(vE)<br/>
&nbsp;&nbsp;&nbsp;&nbsp; Wend<br/>
&nbsp;&nbsp;&nbsp;&nbsp; Print &quot;Done.&quot;<br/>
&nbsp;&nbsp;&nbsp;&nbsp; Exit Sub<br/>
SErrorHandler:<br/>
&nbsp;&nbsp;&nbsp;&nbsp; Print &quot;Error: &quot; &amp; Cstr(Err) &amp; &quot; &quot; &amp; Error$ &amp; &quot;, line: &quot; &amp; Cstr(Erl)<br/>
&nbsp;&nbsp;&nbsp;&nbsp; Exit Sub<br/>
End Sub
</en-note>      ]]>
    </content>
  </note>
  <note>
    <title>크로스에디터 호환성보기 지원하지 않는 이유</title>
    <created>20171218T082629Z</created>
    <updated>20171218T082633Z</updated>
    <note-attributes>
      <author>bbb1sss2@gmail.com</author>
      <source>desktop.win</source>
      <source-url>
        http://gw.nanobrain.co.kr/mail/mcjung.nsf/0/C4A103A7B698042B28761A80BC63C534/?OpenDocument&amp;Form=s_MailMemoReadBodyContent&amp;PresetFields=s_NoMarkRead;0undefineds_HideRemoteImage;1undefineds_HideImages;0
      </source-url>
      <source-application>evernote.win32</source-application>
    </note-attributes>
    <content>
      <![CDATA[<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!DOCTYPE en-note SYSTEM "http://xml.evernote.com/pub/enml2.dtd">

<en-note><div><p style="TEXT-ALIGN: justify; TEXT-JUSTIFY: inter-ideograph; TEXT-AUTOSPACE:"><span style="FONT-SIZE: 10pt; FONT-FAMILY: &quot;맑은 고딕&quot;">안녕하세요<span lang="EN-US">.</span> ㈜나모 에디터 입니다<span lang="EN-US">.</span></span></p><p style="TEXT-ALIGN: justify; TEXT-JUSTIFY: inter-ideograph; TEXT-AUTOSPACE:"><span lang="EN-US" style="FONT-SIZE: 10pt; FONT-FAMILY: &quot;맑은 고딕&quot;">&nbsp;</span></p><p style="TEXT-ALIGN: justify; TEXT-JUSTIFY: inter-ideograph; TEXT-AUTOSPACE:"><span style="FONT-SIZE: 10pt; FONT-FAMILY: &quot;맑은 고딕&quot;">호환성보기 설정의 경우에는 브라우저의 랜더링을 강제로 변경하는 설정이기 때문에<span lang="EN-US">,</span></span></p><p style="TEXT-ALIGN: justify; TEXT-JUSTIFY: inter-ideograph; TEXT-AUTOSPACE:"><span style="FONT-SIZE: 10pt; FONT-FAMILY: &quot;맑은 고딕&quot;">호환성보시 설정 시 정상적인 동작을 보증하지 않습니다<span lang="EN-US">.</span></span></p><p style="TEXT-ALIGN: justify; TEXT-JUSTIFY: inter-ideograph; TEXT-AUTOSPACE:"><span lang="EN-US" style="FONT-SIZE: 10pt; FONT-FAMILY: &quot;맑은 고딕&quot;; COLOR: #1f497d">&nbsp;</span></p><p style="TEXT-ALIGN: justify; TEXT-JUSTIFY: inter-ideograph; TEXT-AUTOSPACE:"><span style="FONT-SIZE: 10pt; FONT-FAMILY: &quot;맑은 고딕&quot;">아래는 호환성보기 설정 시 오류가 발생했던 사례들 입니다<span lang="EN-US">.</span></span></p><ul style="MARGIN-TOP: 0cm" type="disc"><li style="TEXT-ALIGN: justify; MARGIN-LEFT: 2pt; TEXT-JUSTIFY: inter-ideograph; TEXT-AUTOSPACE: ; mso-list: l0 level1 lfo1"><span lang="EN-US" style="FONT-SIZE: 10pt; FONT-FAMILY: &quot;맑은 고딕&quot;">Html5</span> <span style="FONT-SIZE: 10pt; FONT-FAMILY: &quot;맑은 고딕&quot;">기술이 적용된 기능 사용 불가 <span lang="EN-US">(</span>이미지 복사<span lang="EN-US">&amp;</span>붙여넣기<span lang="EN-US">,</span> 차트<span lang="EN-US">,</span> 포토에디터 <span lang="EN-US">html5</span>버전 등<span lang="EN-US">..)</span></span></li><li style="TEXT-ALIGN: justify; MARGIN-LEFT: 2pt; TEXT-JUSTIFY: inter-ideograph; TEXT-AUTOSPACE: ; mso-list: l0 level1 lfo1"><span lang="EN-US" style="FONT-SIZE: 10pt; FONT-FAMILY: &quot;맑은 고딕&quot;">SetUISize (</span><span style="FONT-SIZE: 10pt; FONT-FAMILY: &quot;맑은 고딕&quot;">에디터 사이즈 조정 <span lang="EN-US">API)</span> 사용 불가</span></li><li style="TEXT-ALIGN: justify; MARGIN-LEFT: 2pt; TEXT-JUSTIFY: inter-ideograph; TEXT-AUTOSPACE: ; mso-list: l0 level1 lfo1"><span style="FONT-SIZE: 10pt; FONT-FAMILY: &quot;맑은 고딕&quot;">에디터에 커서가 나타나지 않는 현상</span></li><li style="TEXT-ALIGN: justify; MARGIN-LEFT: 2pt; TEXT-JUSTIFY: inter-ideograph; TEXT-AUTOSPACE: ; mso-list: l0 level1 lfo1"><span style="FONT-SIZE: 10pt; FONT-FAMILY: &quot;맑은 고딕&quot;">에디터 삽입 경로인식이 잘못되어 <span lang="EN-US">CrossEditor is Fail (undefined path)</span> 오류 발생 후 에디터 로딩이 되지 않는 현상</span></li><li style="TEXT-ALIGN: justify; MARGIN-LEFT: 2pt; TEXT-JUSTIFY: inter-ideograph; TEXT-AUTOSPACE: ; mso-list: l0 level1 lfo1"><span style="FONT-SIZE: 10pt; FONT-FAMILY: &quot;맑은 고딕&quot;">표가 삽입되지 않거나 표 그리기 시 선택 영역이 표시되지 않는 현상</span></li></ul><p style="TEXT-ALIGN: justify; TEXT-JUSTIFY: inter-ideograph; TEXT-AUTOSPACE:"><span lang="EN-US" style="FONT-SIZE: 10pt; FONT-FAMILY: &quot;맑은 고딕&quot;; COLOR: #1f497d">&nbsp;</span></p><p style="TEXT-ALIGN: justify; TEXT-JUSTIFY: inter-ideograph; TEXT-AUTOSPACE:"><span style="FONT-SIZE: 10pt; FONT-FAMILY: &quot;맑은 고딕&quot;">에디터에서 강제로 호환성 보기 설정을 해제할 수 없기 때문에<span lang="EN-US">,</span></span></p><p style="TEXT-ALIGN: justify; TEXT-JUSTIFY: inter-ideograph; TEXT-AUTOSPACE:"><span style="FONT-SIZE: 10pt; FONT-FAMILY: &quot;맑은 고딕&quot;">호환성보기 설정은 지원하지 않음을 양해해 주시기 바랍니다<span lang="EN-US">.</span></span></p><p style="TEXT-ALIGN: justify; TEXT-JUSTIFY: inter-ideograph; TEXT-AUTOSPACE:"><span lang="EN-US" style="FONT-SIZE: 10pt; FONT-FAMILY: &quot;맑은 고딕&quot;">&nbsp;</span></p></div><div><br/></div><div style="TEXT-AUTOSPACE:"><span style="FONT-SIZE: 10pt; FONT-FAMILY: &quot;맑은 고딕&quot;">감사합니다<span lang="EN-US">.</span></span></div></en-note>      ]]>
    </content>
  </note>
  <note>
    <title>통신 프로토콜</title>
    <created>20150120T094711Z</created>
    <updated>20150120T094717Z</updated>
    <note-attributes>
      <source-url>http://ko.wikipedia.org/wiki/%ED%86%B5%EC%8B%A0_%ED%94%84%EB%A1%9C%ED%86%A0%EC%BD%9C</source-url>
    </note-attributes>
    <content>
      <![CDATA[<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!DOCTYPE en-note SYSTEM "http://xml.evernote.com/pub/enml2.dtd">

<en-note style="word-wrap: break-word; -webkit-nbsp-mode: space; -webkit-line-break: after-white-space;"><b style="color: rgb(37, 37, 37); font-family: sans-serif; font-size: 14px; line-height: 22.3999996185303px; background-color: rgb(255, 255, 255);">통신 프로토콜</b><span style="color: rgb(37, 37, 37); font-family: sans-serif; font-size: 14px; line-height: 22.3999996185303px; background-color: rgb(255, 255, 255);">&nbsp;또는&nbsp;</span><b style="color: rgb(37, 37, 37); font-family: sans-serif; font-size: 14px; line-height: 22.3999996185303px; background-color: rgb(255, 255, 255);">통신 규약</b><span style="color: rgb(37, 37, 37); font-family: sans-serif; font-size: 14px; line-height: 22.3999996185303px; background-color: rgb(255, 255, 255);">은&nbsp;</span><a href="http://ko.wikipedia.org/wiki/%EC%BB%B4%ED%93%A8%ED%84%B0" style="text-decoration: none; color: rgb(11, 0, 128); font-family: sans-serif; font-size: 14px; line-height: 22.3999996185303px; background-image: none; background-color: rgb(255, 255, 255); background-position: initial initial; background-repeat: initial initial;" title="컴퓨터">컴퓨터</a><span style="color: rgb(37, 37, 37); font-family: sans-serif; font-size: 14px; line-height: 22.3999996185303px; background-color: rgb(255, 255, 255);">나&nbsp;</span><a href="http://ko.wikipedia.org/wiki/%EC%9B%90%EA%B1%B0%EB%A6%AC_%ED%86%B5%EC%8B%A0" style="text-decoration: none; color: rgb(11, 0, 128); font-family: sans-serif; font-size: 14px; line-height: 22.3999996185303px; background-image: none; background-color: rgb(255, 255, 255); background-position: initial initial; background-repeat: initial initial;" title="원거리 통신">원거리 통신</a><span style="color: rgb(37, 37, 37); font-family: sans-serif; font-size: 14px; line-height: 22.3999996185303px; background-color: rgb(255, 255, 255);">&nbsp;장비 사이에서 메시지를 주고 받는 양식과 규칙의 체계이다. 통신 프로토콜은 신호 체계,&nbsp;</span><a href="http://ko.wikipedia.org/wiki/%EC%9D%B8%EC%A6%9D" style="text-decoration: none; color: rgb(11, 0, 128); font-family: sans-serif; font-size: 14px; line-height: 22.3999996185303px; background-image: none; background-color: rgb(255, 255, 255); background-position: initial initial; background-repeat: initial initial;" title="인증">인증</a><span style="color: rgb(37, 37, 37); font-family: sans-serif; font-size: 14px; line-height: 22.3999996185303px; background-color: rgb(255, 255, 255);">, 그리고 오류 감지 및 수정 기능을 포함할 수 있다. 프로토콜은 형식, 의미론, 그리고 통신의 동기 과정 등을 정의하기는 하지만 구현되는 방법과는 독립적이다. 따라서 프로토콜은 하드웨어 또는 소프트웨어 그리고 때로는 모두를 사용하여 구현되기도 한다.</span></en-note>      ]]>
    </content>
  </note>
  <note>
    <title>특정 보기의 모든 Notes 문서들을 빠르게 삭제하기</title>
    <created>20141215T012159Z</created>
    <updated>20141215T012201Z</updated>
    <note-attributes>
      <source-url>
        http://www.techlearning.co.kr/search/label/IBM%20Notes%2FDomino%20%EA%B0%9C%EB%B0%9C?updated-max=2013-10-04T01:57:00%2B09:00&amp;max-results=20&amp;start=59&amp;by-date=false
      </source-url>
    </note-attributes>
    <content>
      <![CDATA[<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!DOCTYPE en-note SYSTEM "http://xml.evernote.com/pub/enml2.dtd">

<en-note style="word-wrap: break-word; -webkit-nbsp-mode: space; -webkit-line-break: after-white-space;"><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">Dim s As New NotesSession</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">Dim db As NotesDatabase</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">Dim vec As NotesViewEntryCollection</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">Dim view As NotesView</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">Set db = s.CurrentDatabase</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">Set view = db.GetView( &quot;TerminatedEmployees&quot; )</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">Set vec = view.AllEntries</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">Call vec.RemoveAll( True )</span></en-note>      ]]>
    </content>
  </note>
  <note>
    <title>특정 템플리트의 설계를 이어받는 모든 데이터베이스 검색하기</title>
    <created>20141215T010456Z</created>
    <updated>20141215T010503Z</updated>
    <note-attributes>
      <source-url>
        http://www.techlearning.co.kr/search/label/IBM%20Notes%2FDomino%20%EA%B0%9C%EB%B0%9C?updated-max=2013-11-15T11:18:00%2B09:00&amp;max-results=20&amp;start=39&amp;by-date=false
      </source-url>
    </note-attributes>
    <content>
      <![CDATA[<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!DOCTYPE en-note SYSTEM "http://xml.evernote.com/pub/enml2.dtd">

<en-note style="word-wrap: break-word; -webkit-nbsp-mode: space; -webkit-line-break: after-white-space;"><span style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);">이번 팁에서는 특정 템플리트의 설계를 이어받는 모든 데이터베이스들을 검색하는 방법을 소개합니다. 이 방법은 검색된 데이터베이스의 수와 목록을 반환해줍니다.</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);">1. 먼저 양식을 작성한 후, 다음과 같이 4개의 필드를 추가합니다.</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);">ServerName (문자열, 편집가능)</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);">TemplateName (문자열, 편집가능)</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);">Number (문자열, 계산, 기본값 : Number)</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);">Databases (문자열, 계산, 기본값 : Databases)</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);">2. 버튼을 작성한 후 다음과 같은 코드를 입력합니다.</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);">&nbsp;&nbsp;</span><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">Sub Click(Source As Button)</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">Dim workspace As New NotesUIWorkspace&nbsp;</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">Dim db As NotesDatabase</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">Dim uidoc As NotesUIDocument</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">Dim doc As NotesDocument</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">Set uidoc = workspace.CurrentDocument</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">Set doc = uidoc.Document</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">Dim strServ As String</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">strServ = doc.ServerName(0)</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">If strServ = &quot;&quot; Then</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">Msgbox &quot;검색할 서버명을 입력하십시요&quot;&nbsp;</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">Call uidoc.GoToField(&quot;ServerName&quot;)</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">Exit Sub</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">End If</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">Dim dbdir As New NotesDbDirectory(strServ)</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">Dim strNTF As String</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">strNTF = doc.TemplateName(0)</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">If strNTF = &quot;&quot; Then</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">Msgbox &quot;검색할 템플리트명을 입력하십시요.&quot;</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">Call uidoc.GoToField(&quot;TemplateName&quot;)</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">Exit Sub</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">End If</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">Dim cnt As Integer</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">cnt = 0</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">Set db = dbdir.GetFirstDatabase(DATABASE)</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">While Not (db Is Nothing)</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">If db.DesignTemplateName = strNTF Then</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">&nbsp;&nbsp; &nbsp; &nbsp;doc.databases = db.Title &amp; &quot; &nbsp; &nbsp;FILE: &quot; &amp; db.filepath &amp; Chr(10) &amp; doc.databases(0)</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">&nbsp;&nbsp; &nbsp; &nbsp;cnt = cnt + 1</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">End If</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">Set db = dbdir.GetNextDatabase</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">Wend</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">If doc.databases(0) = &quot;&quot; Then</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">doc.databases = &quot;검색 결과 없음&quot;</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">End If</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">doc.Number = Str(cnt) + &quot; 개의 데이터베이스 발견&quot;</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">End Sub</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);">3. ServerName 필드에 서버명, TemplateName 필드에 템플리트명을 입력한 후 버튼을 클릭하면, 검색된 데이터베이스 수와 목록이 Number 필드, Databases 필드에 각각 표시됩니다.</span></en-note>      ]]>
    </content>
  </note>
