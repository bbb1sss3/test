    <content>
      <![CDATA[<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!DOCTYPE en-note SYSTEM "http://xml.evernote.com/pub/enml2.dtd">

<en-note><div><br/></div><div><br/></div><div><span style="word-wrap: break-word; -webkit-nbsp-mode: space; -webkit-line-break: after-white-space;">&lt;script type=\&quot;text/javascript\&quot; src=\&quot;http://code.jquery.com/jquery-latest.min.js\&quot;&gt;&lt;/script&gt;</span></div><div><br/></div><div><br/></div><div><br/></div><div>$(document).ready(function() {</div><div><br/></div><div>$(&quot;input[name=ReceiverUserList]&quot;).attr(&quot;value&quot;,myArray3[0]);&nbsp;&nbsp;&nbsp;&nbsp;</div><div><div><span style="word-wrap: break-word; -webkit-nbsp-mode: space; -webkit-line-break: after-white-space;">$(\&quot;input[name=foo]\&quot;).attr(\&quot;checked\&quot;, true);</span></div><div><br/></div><div><span style="word-wrap: break-word; -webkit-line-break: after-white-space;">$(&quot;#A</span>liasName42&quot;).text</div><div><span style="word-wrap: break-word; -webkit-nbsp-mode: space; -webkit-line-break: after-white-space;">alert(&quot;g&quot;);</span></div><span style="word-wrap: break-word; -webkit-nbsp-mode: space; -webkit-line-break: after-white-space;">});</span></div><div><br/></div></en-note>      ]]>
