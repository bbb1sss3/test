      <div style="font-family:&apos;Malgun Gothic&apos;, Gulim, &apos;Segoe UI&apos;, &apos;Lucida Grande&apos;, Verdana, Arial, Helvetica, sans-serif;">
        
        <h2 style="font-family:&apos;Segoe UI Semibold&apos;, &apos;Segoe UI&apos;, &apos;Lucida Grande&apos;, Verdana, Arial, Helvetica, sans-serif;color:rgb(0, 0, 0);font-size:13px;font-weight:normal;margin:0px;font-style:normal;margin-top:9px;margin-bottom:19px;padding:0px;">
          <div style="font-family:&apos;Malgun Gothic&apos;, Gulim, &apos;Segoe UI&apos;, &apos;Lucida Grande&apos;, Verdana, Arial, Helvetica, sans-serif;">
            <a href="#" title="축소하려면 클릭하십시오. 모두 축소하려면 두 번 클릭하십시오." style="font-family:&apos;Malgun Gothic&apos;, Gulim, &apos;Segoe UI&apos;, &apos;Lucida Grande&apos;, Verdana, Arial, Helvetica, sans-serif;outline:none;text-decoration:none;color:rgb(0, 0, 0);">
              <span style="font-family:&apos;Malgun Gothic&apos;, Gulim, &apos;Segoe UI&apos;, &apos;Lucida Grande&apos;, Verdana, Arial, Helvetica, sans-serif;border-width:0px;vertical-align:middle;margin-bottom:0px;float:left;margin-top:12px;display:block;padding:0px 5px 0px 0px;width:9px;height:12px;overflow:hidden;background:url(http://i3.msdn.microsoft.com/Areas/Epx/Content/Images/ImageSprite.png?v=635533092500576233) -470px -3px no-repeat scroll;"></span>
              <span style="font-family:&apos;Malgun Gothic&apos;, Gulim, &apos;Segoe UI&apos;, &apos;Lucida Grande&apos;, Verdana, Arial, Helvetica, sans-serif;display:block;color:rgb(0, 0, 0);font-size:1.769em;">파트</span>
            </a>
            <div style="font-family:&apos;Malgun Gothic&apos;, Gulim, &apos;Segoe UI&apos;, &apos;Lucida Grande&apos;, Verdana, Arial, Helvetica, sans-serif;padding-top:0px;">
              
            </div>
          </div>
        </h2>
