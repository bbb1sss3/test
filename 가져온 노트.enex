  <note>
    <title>소재 재무팀undefined 기획원가팀으로 문서 수신처 복사좀해주세요ㅇ</title>
    <created>20141117T113621Z</created>
    <updated>20141117T113744Z</updated>
    <note-attributes>
    </note-attributes>
    <content>
      <![CDATA[<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!DOCTYPE en-note SYSTEM "http://xml.evernote.com/pub/enml2.dtd">

<en-note style="word-wrap: break-word; -webkit-nbsp-mode: space; -webkit-line-break: after-white-space;">
@SetField(&quot;Receiver&quot;;&quot;수신처 참조&quot;);<br/>
@SetField(&quot;ReceiverDisplay&quot;;&quot;소재-재무팀&quot;:&quot;소재-기획원가팀&quot;);<br/>
@SetField(&quot;NameList&quot;;&quot;소재-재무팀&quot;:&quot;소재-기획원가팀&quot;);<br/>
@SetField(&quot;CodeList&quot;;&quot;B22100&quot;:&quot;B22050&quot;);<br/>
@SetField(&quot;SendToLine&quot;;&quot;2&quot;);<br/>
@SetField(&quot;ReceiverSetList&quot;;&quot;소재-재무팀&quot;:&quot;소재-기획원가팀&quot;);<br/>
SELECT @All
<div><br/></div><div>처리대기문서 기안자별</div><div><br/></div></en-note>      ]]>
    </content>
  </note>
