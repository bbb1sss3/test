    <content>
      <![CDATA[<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!DOCTYPE en-note SYSTEM "http://xml.evernote.com/pub/enml2.dtd">

<en-note style="word-wrap: break-word; -webkit-nbsp-mode: space; -webkit-line-break: after-white-space;"><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">Sub Click(Source As Button)</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">On Error Goto processError</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">Dim ws As New NotesUIWorkspace</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">Dim s As New NotesSession</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">Dim uidoc As NotesUIDocument</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">Dim colDoc As NotesDocument</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">Dim colViews() As String</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">Dim doc As NotesDocument</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">Dim uidb As NotesUIDatabase</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">Dim db As NotesDatabase</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">Dim thisView As String&nbsp;</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">Dim i As Integer</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">i = 0&nbsp;</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">Set db = s.CurrentDatabase</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">Set uidb = ws.CurrentDatabase</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">Forall v In db.Views</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">temp = Cstr(v.name)</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">Redim Preserve colViews(i + 1)</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">colViews(i) = v.name &nbsp;&nbsp;</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">i = i + 1 &nbsp;&nbsp;</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">End Forall</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">thisView = ws.Prompt(PROMPT_OKCANCELLIST, &quot;보기 목록&quot;, &quot;보기를 선택하십시요.&quot;, &nbsp;colViews(0), colViews)</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">Call ws.SetTargetFrame(&quot;your_target_frame&quot;)</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">Call uidb.OpenView(thisView)&nbsp;</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">processError:</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">Resume Next</span><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><br style="color: rgb(34, 34, 34); font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; background-color: rgb(255, 255, 255);"/><span style="font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 13px; line-height: 18.4799995422363px; color: rgb(102, 0, 0); background-color: rgb(255, 255, 255);">End Sub</span></en-note>      ]]>
    </content>
  </note>
