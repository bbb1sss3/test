  <note>
    <title>제목 없는 노트</title>
    <created>20190919T084226Z</created>
    <updated>20210208T030419Z</updated>
    <note-attributes>
      <source>web.clip</source>
      <source-url>http://i.bn-korea.com/eni/dealbox_test.nsf/WebAprDoneView?OpenView&amp;Start=1&amp;Count=13</source-url>
      <source-application>evernote.win32</source-application>
    </note-attributes>
    <content>
      <![CDATA[<?xml version="1.0" encoding="UTF-8" standalone="no"?>
